# ---- Core ---------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=8000

# ---- Database -----------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/swasthya_sathi

# ---- Sessions / tokens --------------------------------------------------
SESSION_SECRET=change-me-session-secret
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_TTL=900
SESSION_TTL_DAYS=7

# ---- Authentication provider -------------------------------------------
# `mock` enables demo login (including on a Vercel deployment). Use
# `meripehchaan` with the MeriPehchaan vars below for a real SSP integration.
AUTH_PROVIDER=mock

# ---- MeriPehchaan (government SSO) ------------------------------------
MERIPEHCHAAN_CLIENT_ID=
MERIPEHCHAAN_CLIENT_SECRET=
MERIPEHCHAAN_REDIRECT_URI=
MERIPEHCHAAN_AUTH_URL=
MERIPEHCHAAN_TOKEN_URL=
MERIPEHCHAAN_USERINFO_URL=

# ---- ISRO Bhuvan (geospatial / GIS) -----------------------------------
BHUVAN_API_BASE_URL=
BHUVAN_API_KEY=

# ---- Mappls / MapMyIndia (maps + routing) -----------------------------
MAPPLS_API_BASE_URL=
MAPPLS_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

# ---- BharatVC (video consultation) ------------------------------------
BHARATVC_BASE_URL=
BHARATVC_CLIENT_ID=
BHARATVC_CLIENT_SECRET=

# ---- GovDrive (encrypted document storage) -----------------------------
GOVDRIVE_BASE_URL=
GOVDRIVE_CLIENT_ID=
GOVDRIVE_CLIENT_SECRET=

# ---- Internal AI service (Python FastAPI) ------------------------------
AI_SERVICE_URL=http://127.0.0.1:8100
AI_SERVICE_SECRET=dev-ai-internal-secret-9f2

# ---- Security / limits --------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10
UPLOAD_MAX_BYTES=10485760
BODY_LIMIT=1mb

# ---- Redis (optional, only for multi-instance Socket.IO later) ----------
REDIS_URL=

# ---- Data retention -----------------------------------------------------
RETENTION_AUDIT_DAYS=3650
RETENTION_TRIAGE_DAYS=730
RETENTION_GPS_DAYS=0
TRUST_PROXY=false

# ---- Vercel serverless (hosted demo) ------------------------------------
# When the backend is deployed to Vercel (root directory: backend), set these
# in the project's environment variables rather than in a committed .env:
#
#   AUTH_PROVIDER=mock            # demo provider; mock login stays enabled
#   CORS_ORIGINS=https://<frontend-host>.vercel.app
#   TRUST_PROXY=true              # rate limiting honours X-Forwarded-For
#   SESSION_SECRET=<long random string>
#   JWT_SECRET=<long random string>
#   MONGODB_URI=<optional Atlas URI>
#
# The servers/function Docker entrypoint still fails fast on AUTH_PROVIDER=mock
# with NODE_ENV=production (config/env.ts validateEnv) — the serverless entry
# does not call validateEnv, so a mock login stays available on the hosted
# backend. If no MONGODB_URI is reachable, the frontend falls back to its local
# demo session, so the app still renders fully.
#
# Deployment shape (backend root):
#   api/index.ts      → Express app served as one Vercel Node function
#   api/v1/health.ts  → dependency-free liveness at /api/v1/health
#   vercel.json       → rewrites every path to /api/index
