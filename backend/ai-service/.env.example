# Swasthya Sathi AI Service — Configuration
# No external API keys required. Uses local rule-based engine.

# CORS origins for the AI service
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Maximum conversation history messages to keep in memory
MAX_HISTORY_MESSAGES=20

# Shared secret the Node backend must send as X-AI-Service-Secret.
# Keep empty in development; set a strong value in production.
AI_SERVICE_SECRET=change-me-ai-service-secret
